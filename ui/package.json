{
  "name": "ragondin-ui",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "vite build",
    "tokens": "node scripts/gen-tokens.mjs",
    "types:check": "node scripts/check-api-types.mjs",
    "audit": "node scripts/check-font-licenses.mjs && node scripts/check-licenses.mjs && node scripts/check-advisories.mjs",
    "check": "npm run types:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run audit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
